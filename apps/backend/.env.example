# Supabase API (Untuk Auth & Admin Invite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project > Connect > Session pooler (port 5432)
DATABASE_URL=

# Telegram
# Mode penerimaan pesan: "polling" (default, untuk self-hosted lokal tanpa tunnel) atau "webhook"
# Pada mode polling, pesan yang dikirim saat server mati akan tetap diproses saat start (drop_pending_updates=False).
TELEGRAM_MODE=polling
# Token bot Telegram dari @BotFather
TELEGRAM_BOT_TOKEN=
# Wajib jika TELEGRAM_MODE=webhook. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Chat ID admin untuk otorisasi perintah /invite (angka)
ADMIN_CHAT_ID=

# Google ADK / Gemini — API key dari https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_MODEL=

# Zona waktu untuk "hari ini" / "minggu ini" di ringkasan
APP_TIMEZONE=
