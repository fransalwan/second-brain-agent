# Supabase — Project > Connect > Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Telegram
TELEGRAM_BOT_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Google ADK / Gemini — API key dari https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.5-flash

# Zona waktu untuk "hari ini" / "minggu ini" di ringkasan
APP_TIMEZONE=Asia/Jakarta
