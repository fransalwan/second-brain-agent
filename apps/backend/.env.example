# Supabase API (Untuk Auth & Admin Invite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Project > Connect > Session pooler (port 5432)
DATABASE_URL=

# Telegram (PENGEMBANGAN LOKAL)
# PERHATIAN: Gunakan token & secret dari Bot Development (misal @SecondBrainDevBot).
# Telegram hanya mengizinkan 1 URL webhook per bot token. Jika memakai bot produksi,
# tunnel ngrok lokal akan menimpa webhook produksi dan mematikan bot pengguna.
# Kredensial Bot Produksi disetel langsung di Dashboard Render, bukan di file ini.
TELEGRAM_BOT_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Chat ID admin untuk otorisasi perintah /invite (angka)
ADMIN_CHAT_ID=

# Google ADK / Gemini — API key dari https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GEMINI_MODEL=

# Zona waktu untuk "hari ini" / "minggu ini" di ringkasan
APP_TIMEZONE=
